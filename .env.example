# 複製成 .env 後填入。.env 已在 .gitignore 內，不會進版控。

# eBird 金鑰，到 https://ebird.org/api/keygen 申請，免費即發即用。
# 沒填的話 eBird 同步會自動跳過，其餘功能不受影響。
EBIRD_API_KEY=

# 以下都有預設值，不需要就整行刪掉。

# eBird 區域代碼，台灣是 TW，縣市層級可用 TW-TPE 這種寫法
EBIRD_REGION=TW

# 資料庫位置
# WILDMAP_DB=C:\Users\Yen\Desktop\wildmap\data\wildmap.db

# 網格新記錄警示的網格邊長（度），0.05 約 5 公里
WILDMAP_CELL_SIZE=0.05

# 判定「該網格首次出現」時回看的天數
WILDMAP_BASELINE_DAYS=365

# 同步間隔（秒）。預設是在家看地圖的節奏，一天各拉幾次就夠。
# iNat 每次增量通常一兩頁就抓完，拉長間隔不會漏資料，只是晚一點看到。
WILDMAP_INTERVAL_INAT=21600
# eBird 的即時端點最多回溯 30 天，別設超過一天
WILDMAP_INTERVAL_EBIRD=43200
# 保育名錄變動極少
WILDMAP_INTERVAL_TBN=2592000

# 首次啟動時回填的天數
WILDMAP_BACKFILL_DAYS=180
